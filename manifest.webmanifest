{
  "id": "./",
  "name": "Tekla Studio PWA: Formula, TplEd & .inp Workbench",
  "short_name": "Tekla Studio",
  "description": "Offline workbench for Tekla Structures detailers: write, format, validate and store Custom Component formulas, Template Editor scripts, objects.inp attributes and MTO data.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "utilities", "developer"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "icons/icon-192.png.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-512.png.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ]
}
